# Supabase — get from https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your-service-role-key-here

# CORS — comma-separated list of allowed origins. In production this should
# be your deployed frontend URL (no trailing slash). For local dev, use "*".
CORS_ORIGINS=https://your-frontend.vercel.app

# Hugging Face token (optional — needed for gated models)
HF_TOKEN=hf_xxxxxxxxxxxxxxx

# Model overrides (optional — defaults shown)
DEFAULT_MODEL=BAAI/bge-large-en-v1.5
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Gates /api/ingest/* and /api/scrape/* with an X-API-Key header.
# Leave blank for open access (local dev). Set to any random string in
# production — the frontend's config.js must use the same value.
API_KEY=

# Rate limits (slowapi syntax). Override per environment if needed.
RATE_LIMIT_MATCH=20/minute
RATE_LIMIT_SCRAPE=3/minute
RATE_LIMIT_INGEST=10/minute
